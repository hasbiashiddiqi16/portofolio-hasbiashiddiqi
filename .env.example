# Mode Dinamis (Vercel) — salin nilainya ke Vercel > Settings > Environment Variables.
# Jangan commit token asli ke Git.

# Otomatis terisi saat membuat Vercel Blob (Vercel > Storage > Create > Blob).
BLOB_READ_WRITE_TOKEN=

# Password yang diterima server untuk menerbitkan konten.
# Samakan dengan password login dashboard (default awal: admin123).
CMS_PASSWORD=
